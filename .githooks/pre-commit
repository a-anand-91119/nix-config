#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
echo "Checking staged Nix syntax..."

# Parse the staged content, even when the working copy has additional edits.
if ! git diff --cached --name-only --diff-filter=ACMR -z |
  while IFS= read -r -d '' file; do
    case "$file" in
      *.nix)
        if ! git show ":$file" | nix-instantiate --parse - >/dev/null; then
          echo "Staged syntax check failed: $file" >&2
          exit 1
        fi
        ;;
    esac
  done
then
  exit 1
fi

flake_changes=$(git diff --cached --name-only -- flake.nix flake.lock)
if [[ -n "$flake_changes" ]]; then
  echo "Evaluating the current checkout (including new module files)..."
  nix flake check --all-systems --no-build --no-update-lock-file "path:$repo_root"
fi
echo "Pre-commit checks passed."
